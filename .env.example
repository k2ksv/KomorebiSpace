# Database configuration
POSTGRES_DB=komorebi
POSTGRES_USER=komorebi
POSTGRES_PASSWORD=replace-with-a-strong-random-password-in-production

# JWT Authentication (at least 32 characters for HMAC-SHA256)
JWT_SECRET=replace-with-a-64-character-hex-or-base64-random-secret
JWT_EXPIRATION_MS=86400000

# CORS & Domain Routing
# For local production simulation via Caddy, use https://localhost or your domain.
DOMAIN=localhost
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api

# Cookie Security Settings
COOKIE_SECURE=true
COOKIE_CROSS_SITE=false
